<?xml version="1.0" encoding="utf-8"?>
<!-- Separate community MSI identity. Never reuse the official UpgradeCode. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Keyboard Configurator Quick Switch (Unofficial)"
           Manufacturer="Keyboard Configurator community build"
           UpgradeCode="89D7C4D0-038F-48D9-AF03-5E1D980C8034"
           Language="1041" Codepage="932" Version="$(var.ProductVersion)">
    <Package Id="*" InstallerVersion="500" Platform="x64" InstallScope="perMachine"
             Compressed="yes" Languages="1041" SummaryCodepage="932"
             Description="Unofficial 64-bit Keyboard Configurator with Quick Switch" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="!(loc.NewerVersionInstalled)" />
    <Upgrade Id="89D7C4D0-038F-48D9-AF03-5E1D980C8034">
      <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="yes"
                      OnlyDetect="yes" Property="SAME_OR_NEWER_FOUND" />
    </Upgrade>
    <Condition Message="!(loc.SameOrNewerVersionInstalled)">
      Installed OR NOT SAME_OR_NEWER_FOUND
    </Condition>
    <Condition Message="!(loc.Requires64BitWindows)">VersionNT64</Condition>
    <Property Id="ARPHELPLINK" Value="https://github.com/pop-os/keyboard-configurator" />
    <!-- No launch/custom action: installing never discovers or writes hardware. -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Keyboard Configurator Quick Switch" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="QuickSwitchMenu" Name="Keyboard Configurator Quick Switch" />
      </Directory>
    </Directory>
    <Feature Id="Complete" Title="Quick Switch" Level="1" Absent="disallow">
      <ComponentGroupRef Id="QuickSwitchPayload" />
    </Feature>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Product>
</Wix>